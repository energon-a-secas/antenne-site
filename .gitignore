# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Playwright MCP (Claude Code browser automation: screenshots, logs) ───────
.playwright-mcp/

# ── Playwright test artifacts ─────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Secrets, never commit ─────────────────────────────────────────────────────
.env
.env.*
# …but the credentials TEMPLATE is repo content: a fresh clone needs it
!.env.example

# ── Ephemeral skill working state (see neorgon-forge/docs/authoring.md) ───────
# Session briefs and maps. Useful while the work happens, not repo content, and
# on a site repo this directory is public.
.forge/

# ── Python bytecode ───────────────────────────────────────────────────────────
# smoke check 6 creates __pycache__ at repo root while exercising the tooling.
__pycache__/
*.py[cod]

# ── Logs ──────────────────────────────────────────────────────────────────────
# A site that deliberately ARCHIVES a log (rewind-site keeps the server.log of
# each snapshot) negates this in its own .gitignore. See REPO-ORGANIZATION.md.
*.log

# ── Archived skills (scripts/prune-skills.sh) ─────────────────────────────────
skills-archived/

# ── Convex generated code ─────────────────────────────────────────────────────
# npx convex deploy writes it from convex/*.ts; it is never committed
# (docs/plans/2026-09-15-antenne-desk.md section 2, in the Neorgon monorepo).
# Drafts are not files any more: they live in the desk's Convex backend, and a
# story enters this public repo only when the publish workflow commits it to
# data/posts.json.
convex/_generated/
# Guard: nothing writes data/drafts/ now, but a stale one from the old /newsroom flow must never be committed.
data/drafts/
